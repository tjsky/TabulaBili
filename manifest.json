{
  "manifest_version": 3,
  "name": "TabulaBili-Plus (初见哔哩增强版) [Firefox]",
  "version": "1.2.0",
  "author": "去年夏天",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabulabili-firefox@tjsky.github",
      "strict_min_version": "128.0"
    }
  },
  "description": "通过精细化控制网络请求与首屏加载，提供纯净、刷新、混合等多维度的B站首页大盘推荐流体验，打破信息茧房。",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://api.bilibili.com/*",
    "*://www.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.bilibili.com/*", "*://www.bilibili.com/?*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.bilibili.com/*", "*://www.bilibili.com/?*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}